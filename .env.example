# Supported BTC 15-minute deployment surface (55 keys).
#
# Strategy defaults and advanced diagnostics live in
# config/profiles/btc15_twap_v3.env. Keep wallet secrets only in local .env.

STRATEGY_PROFILE=btc15_twap_v3

# Outcome research is deliberately BTC 1d-only.  A missing daily market must
# wait rather than silently switching this repo to a different period.
OUTCOME_MARKET_PERIODS=1d
OUTCOME_MARKET_ALLOW_FALLBACK=0

# Production Outcome strategy is entered solely by ``bot.launcher --live``
# after its typed confirmation and one-wallet lock. It requires fresh Binance
# public OI written into the same journal; no execution gate flags are needed.
OUTCOME_LIVE_STRATEGY_TARGET_RETURN_PCT=0.05
OUTCOME_LIVE_STRATEGY_NARROW_AFTER_SEC=3600
OUTCOME_LIVE_STRATEGY_NARROW_RETURN_PCT=0.03
OUTCOME_LIVE_STRATEGY_FLOOR_AFTER_SEC=7200
OUTCOME_LIVE_STRATEGY_FLOOR_RETURN_PCT=0.02
OUTCOME_LIVE_STRATEGY_SPOT_STRIKE_MIN_BPS=15
OUTCOME_LIVE_STRATEGY_MARK_RETURN_MIN_BPS=5
OUTCOME_LIVE_STRATEGY_OI_RETURN_MIN_BPS=1
OUTCOME_LIVE_STRATEGY_OI_LOOKBACK_SEC=300
OUTCOME_LIVE_STRATEGY_OI_MAX_AGE_SEC=90
# Do not enter the initial/uncertain 50–55% range. Applied to selected maker bid.
OUTCOME_LIVE_STRATEGY_MIN_ENTRY_PRICE=0.55
OUTCOME_MAX_ENTRY_NOTIONAL_USDC=11
OUTCOME_MAX_OUTCOME_EXPOSURE_USDC=11
OUTCOME_MAX_OPEN_ORDERS=1
OUTCOME_EXECUTION_JOURNAL_PATH=./logs/outcome_shadow.db
LIVE_PROCESS_LOCK_PATH=/tmp/hyperliquid-outcome-strategy-live.lock

# Live launcher owns one read-only P2/P3 capture stream for its journal.  It
# records a heartbeat and a non-interpolated gap alert; neither setting grants
# an order permission.
OUTCOME_RESEARCH_CAPTURE_INTERVAL_SEC=5
OUTCOME_RESEARCH_HEARTBEAT_SEC=60
OUTCOME_RESEARCH_GAP_ALERT_SEC=30

# Public Binance OI collector liveness telemetry; it has no Binance account
# or trading capability.
BINANCE_OI_HEARTBEAT_SEC=60
BINANCE_OI_GAP_ALERT_SEC=90

# Credentials and venue connection
POLYMARKET_PK=
POLYMARKET_FUNDER=
POLYGON_RPC_URL=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Settlement reference and lifecycle
POLYMARKET_CHAINLINK_TWAP_ENABLED=1
POLYMARKET_CHAINLINK_TWAP_WINDOW_SEC=60
REQUIRE_TWAP_REFERENCE_SPOT=1
TWAP_DEGRADED_BLOCK_NEW_ENTRIES=1
QUOTE_STALE_SEC=30
QUOTE_RESUBSCRIBE_GRACE_SEC=12
AUTO_NODE_ROLLOVER_ENABLED=1
AUTO_NODE_RESTART_ON_UNEXPECTED_EXIT=1

# Five-layer entry decision
ENTRY_SCORE_MIN=0.20
FIRST_ENTRY_SCORE_MIN=0.22
FIRST_ENTRY_MAX_TIME_LEFT_SEC=720
ENTRY_MIN_TIME_LEFT_SEC=60
ENTRY_MAX_FAIR_PRICE=0.90
EXTERNAL_CONFIRMATION_ENABLED=1
EXTERNAL_CONFLICT_BOOK_MID_THRESHOLD_PS=0.02
EXTERNAL_CONFLICT_ACTION=skip
ENTRY_MIN_ROBUST_NET_USDC=0.001
EXECUTION_COST_LOOKBACK_HOURS=168
EXECUTION_COST_MIN_SAMPLES=30

# Execution and per-market exposure
MARKET_TARGET_SHARES=10
HIGH_PRICE_THRESHOLD=0.70
HIGH_PRICE_TARGET_SHARES=5
MARKET_MAX_POSITION_SHARES=10
# One successful BUY entry per market is a hard safety invariant.
ORDER_POST_ONLY=1
ORDER_TTL_SEC=20
ORDER_REQUOTE_MIN_AGE_SEC=6
ORDER_REQUOTE_HYSTERESIS_TICKS=1

# Exit and redemption authority
HOLD_TO_REDEEM=1
RECOVERY_EXIT_ENABLED=1
RECOVERY_EXIT_REQUIRE_TWAP_CONFIRMATION=1
RECOVERY_EXIT_MAX_TIME_LEFT_SEC=720
RECOVERY_EXIT_MIN_HOLD_SEC=120
AUTO_REDEEM_ENABLED=1

# Observability and research
TRADE_DB_ENABLED=1
TRADE_DB_PATH=./logs/trade_journal.db
DASHBOARD_THEME=light
TERMINAL_DASHBOARD=0
FAIR_EDGE_BUCKET_SHADOW_ENABLED=1
SHADOW_SIMULATION_ENABLED=1
STARTUP_VERBOSE=0
