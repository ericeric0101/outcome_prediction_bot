# Hyperliquid Outcome BTC daily bot — supported local settings only.
# Live launch itself authorizes automated execution; do not add venue aliases
# or per-run execution switches here.

HL_WALLET_ADDRESS=
HL_PRIVATE_KEY=
HL_AGENT_PRIVATE_KEY=
HL_TESTNET=0
HL_BASE_URL=
HL_WS_URL=

# The current scope is only BTC daily Outcome.
OUTCOME_MARKET_PERIODS=1d
OUTCOME_MARKET_ALLOW_FALLBACK=0
OUTCOME_EXECUTION_JOURNAL_PATH=./logs/outcome_shadow.db
LIVE_PROCESS_LOCK_PATH=/tmp/hyperliquid-outcome-strategy-live.lock

# Entry policy. Defaults are code-owned; only values that need a deliberate
# operator override belong here.
OUTCOME_TIER_B_ENABLED=1
# Temporary, explicit C4 kill switch.  Keep off until C3 candidate-path
# evidence has independent completed daily-market coverage.
OUTCOME_TREND_CONTINUATION_ENABLED=0
OUTCOME_LIVE_STRATEGY_MIN_ENTRY_PRICE=0.55
# Reviewed admission safety policy: zero-fill owned BUY resting for 60 seconds
# is cancelled through the normal hardened cancel-confirm path and must re-arm.
OUTCOME_STALE_ENTRY_CANCEL_ENABLED=0
OUTCOME_STALE_ENTRY_CANCEL_SEC=60
OUTCOME_MAX_ENTRY_NOTIONAL_USDC=20
OUTCOME_MAX_OUTCOME_EXPOSURE_USDC=20
OUTCOME_MAX_OPEN_ORDERS=1

# Tail-risk hardening.  These are intentionally opt-in risk-reduction
# experiments: neither creates a new exit authority or alters entry signals.
# Stress sizing can only reduce a $20-cap order from current visible bid depth.
OUTCOME_STRESS_EXITABILITY_ENABLED=0
OUTCOME_STRESS_EXITABILITY_DEPTH_HAIRCUT_10PCT=0.60
OUTCOME_STRESS_EXITABILITY_DEPTH_HAIRCUT_15PCT=0.45
OUTCOME_STRESS_EXITABILITY_SPREAD_WIDENING_BPS=0
# Bounded-risk episodes replace a permanent attempt counter only when enabled.
# Existing S3 / fast-failure conditions and controller remain authoritative.
OUTCOME_RISK_EPISODE_BUDGET_ENABLED=0
# Leave disabled in copied profiles until an operator explicitly authorizes
# the shared-budget $10 narrow hard-failure IOC canary.
OUTCOME_NARROW_HARD_FAILURE_CANARY_ENABLED=0
# Explicit operator switch for every loss-triggered exit: fast-failure, S3,
# narrow hard-failure IOC, and passive loss-band repricing.  When disabled,
# an already owned loss-band SELL is safely cancel-confirm-rebooked to normal
# TP where account truth and a fresh passive TP quote allow it; ambiguity
# stays blocked rather than leaving inventory unprotected.  It never disables
# normal take-profit, settlement, reduce-only cleanup, ambiguity fencing, or
# account reconciliation.
OUTCOME_LOSS_EXIT_ENABLED=1
# Optional non-secret deployment label recorded in the startup manifest.
OUTCOME_DEPLOYMENT_ID=

# Capture health.
OUTCOME_RESEARCH_CAPTURE_INTERVAL_SEC=5
OUTCOME_RESEARCH_HEARTBEAT_SEC=60
OUTCOME_RESEARCH_GAP_ALERT_SEC=30
BINANCE_OI_HEARTBEAT_SEC=60
BINANCE_OI_GAP_ALERT_SEC=90
# Public-only Deribit research source.  It must remain detached from Outcome
# execution.  No Deribit API key is needed or accepted by this first stage.
DERIBIT_RESEARCH_ENABLED=0
DERIBIT_RESEARCH_SNAPSHOT_INTERVAL_SEC=1
DERIBIT_RESEARCH_MAX_AGE_SEC=3
